# ==============================================================================
# AutoProcure Environment Configuration Example
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit `.env` containing live or sandbox secrets to version control.
# ==============================================================================

# --- PayPal Developer Sandbox / Live Credentials ------------------------------
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# Optional: PayPal Vault ID for autonomous merchant-initiated auto-capture (Tier 1).
# Leave blank to use standard 1-click PayPal checkout approval flows.
# Can be created at runtime via POST /mandate/setup.
PAYPAL_VAULT_ID=

# --- Google Gemini AI API Key -------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- Application Security & Server --------------------------------------------
# Optional: Bearer/Header API key to restrict /procure, /requests, and /mandate/setup.
# Leave blank for local open development.
AUTOPROCURE_API_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# --- Corporate Policy Guardrails (Optional Overrides) -------------------------
# POLICY_AUTO_APPROVE_LIMIT=150.00
# POLICY_ORDER_HARD_CAP=350.00
# POLICY_MAX_UNIT_PRICE=150.00
# POLICY_MONTHLY_BUDGET=1000.00

